import os
import re
import io
import socket
import time
import threading
import subprocess
from flask import Flask, render_template, request, jsonify, send_from_directory, Response, send_file

app = Flask(__name__)

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SONGS_DIR = os.path.join(BASE_DIR, 'songs')
PORT = int(os.environ.get('PORT', 5000))

# 支持的音/视频扩展名
AUDIO_EXTS = {'.mp3', '.wav', '.flac', '.m4a', '.ogg', '.aac', '.wma'}
VIDEO_EXTS = {'.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv'}
SUBTITLE_EXTS = {'.srt', '.vtt', '.ass', '.ssa'}

# 使用用户目录下的最新版 yt-dlp（避免系统旧版无法下载 YouTube）
YTDLP = os.path.expanduser('~/.local/bin/yt-dlp')
if not os.path.isfile(YTDLP):
    YTDLP = 'yt-dlp'

# 播放状态
state = {
    'queue': [],          # 播放队列（歌曲路径列表）
    'current_index': -1,  # 当前播放的队列索引
    'playing': False,
    'volume': 70,
    'current': None,      # 当前歌曲信息
    'mode': 'lead',       # 'lead'=导唱(人声) 'backing'=伴奏
}

# 使用 mpv 播放（树莓派上最稳，若没有则退回默认播放器）
player_proc = None
player_lock = threading.Lock()
auto_thread = None
auto_running = True


def find_subtitle(media_path):
    """查找与媒体文件同名的字幕文件"""
    base = os.path.splitext(media_path)[0]
    for ext in SUBTITLE_EXTS:
        sub_path = base + ext
        if os.path.isfile(sub_path):
            return sub_path
    return None


def find_backing(media_path):
    """查找同名伴奏版（歌名_伴奏.ext）"""
    base, ext = os.path.splitext(media_path)
    backing = base + '_伴奏' + ext
    if os.path.isfile(backing):
        return backing
    return None


def find_songs():
    """扫描 songs 目录，返回歌曲列表"""
    songs = []
    for root, dirs, files in os.walk(SONGS_DIR):
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in AUDIO_EXTS or ext in VIDEO_EXTS:
                # 跳过伴奏版（避免把伴奏当成独立歌曲列出）
                if f.endswith('_伴奏' + ext):
                    continue
                path = os.path.join(root, f)
                name = os.path.splitext(f)[0]
                # 尝试从文件名拆分歌手 - 歌名（如 "张学友 - 吻别"）
                artist = '未知'
                title = name
                m = re.split(r'[-_—–]', name, maxsplit=1)
                if len(m) == 2:
                    artist = m[0].strip()
                    title = m[1].strip()
                subtitle = find_subtitle(path)
                backing = find_backing(path)
                songs.append({
                    'name': name,
                    'path': path,
                    'artist': artist,
                    'title': title,
                    'is_video': ext in VIDEO_EXTS,
                    'subtitle': subtitle,
                    'backing': backing,
                    'size': os.path.getsize(path),
                    'url': '/songs/' + os.path.relpath(path, SONGS_DIR).replace(os.sep, '/'),
                })
    return songs


def play(path):
    """播放指定文件（后台起 mpv，全屏显示视频+字幕）"""
    global player_proc
    with player_lock:
        if player_proc and player_proc.poll() is None:
            player_proc.terminate()
            try:
                player_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                player_proc.kill()
        # 查找同名字幕文件
        subtitle = find_subtitle(path)
        # 用 mpv 全屏播放（视频+字幕）
        cmd = [
            'mpv', '--fullscreen', f'--volume={state["volume"]}',
            '--no-terminal', '--really-quiet',
        ]
        if subtitle:
            cmd.append(f'--sub-file={subtitle}')
        cmd.append(path)
        try:
            subprocess.check_call(['sh', '-c', 'command -v mpv >/dev/null 2>&1'])
            player_proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL)
        except (subprocess.CalledProcessError, FileNotFoundError):
            player_proc = None


def stop_player():
    global player_proc
    with player_lock:
        if player_proc and player_proc.poll() is None:
            player_proc.terminate()
            try:
                player_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                player_proc.kill()


def current_play_path(song):
    """根据模式返回要播放的路径：导唱=原文件，伴奏=同名 _伴奏 文件"""
    if state['mode'] == 'backing' and song.get('backing'):
        return song['backing']
    return song['path']


def play_current():
    if 0 <= state['current_index'] < len(state['queue']):
        song = state['queue'][state['current_index']]
        state['current'] = song
        state['playing'] = True
        play(current_play_path(song))
        return True
    return False


def get_lan_ip():
    """获取本机局域网 IP（供二维码使用）"""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('8.8.8.8', 80))
        ip = s.getsockname()[0]
    except Exception:
        ip = '127.0.0.1'
    finally:
        s.close()
    return ip


def get_qr_url():
    """生成点歌页面的 URL（二维码内容）"""
    ip = get_lan_ip()
    return f'http://{ip}:{PORT}'


def auto_advance():
    """自动播放线程：监听 mpv 播完后自动下一首"""
    global player_proc
    while auto_running:
        with player_lock:
            proc = player_proc
        if proc is None:
            time.sleep(0.5)
            continue
        if proc.poll() is None:
            proc.wait()
        # 该进程已结束。只有当它仍是当前播出的进程时才自动下一首，
        # 避免用户手动切歌后（已换新进程）造成误跳。
        with player_lock:
            if player_proc is proc and state['playing'] and \
               state['queue'] and 0 <= state['current_index'] < len(state['queue']):
                if state['current_index'] < len(state['queue']) - 1:
                    state['current_index'] += 1
                    current = state['queue'][state['current_index']]
                    state['current'] = current
                    play(current['path'])
                else:
                    state['playing'] = False
                    state['current'] = None
        time.sleep(0.5)


def start_auto_adapter():
    global auto_thread
    if auto_thread is None or not auto_thread.is_alive():
        auto_thread = threading.Thread(target=auto_advance, daemon=True)
        auto_thread.start()


@app.route('/')
def index():
    """入口页：显示二维码，点“进入点歌”进入点歌页"""
    return render_template('lobby.html', url=get_qr_url())


@app.route('/dj')
def dj():
    """点歌页：多人排队点歌"""
    return render_template('index.html')


@app.route('/qr.png')
def qr_png():
    """生成二维码图片（扫描进入点歌页）"""
    try:
        import qrcode
        from qrcode.image.pil import PilImage
        url = request.args.get('url', get_qr_url())
        qr = qrcode.QRCode(box_size=10, border=2)
        qr.add_data(url)
        qr.make(fit=True)
        img = qr.make_image(fill_color='#ffffff', back_color='#1e1e2f')
        buf = io.BytesIO()
        img.save(buf, format='PNG')
        buf.seek(0)
        return Response(buf.getvalue(), mimetype='image/png',
                        headers={'Cache-Control': 'no-cache'})
    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)}), 500


@app.route('/api/songs')
def api_songs():
    """返回全部歌曲（可按关键词过滤）"""
    q = request.args.get('q', '').lower()
    songs = find_songs()
    if q:
        songs = [s for s in songs if q in s['name'].lower() or q in s['artist'].lower()]
    return jsonify(songs)


@app.route('/api/play')
def api_play():
    """点歌：加入队列并立即播放"""
    path = request.args.get('path', '')
    if not path:
        return jsonify({'ok': False, 'error': '缺少 path'})
    # 校验文件存在，并转成歌曲 dict 加入队列
    if not os.path.isfile(path):
        return jsonify({'ok': False, 'error': '文件不存在'})
    name = os.path.splitext(os.path.basename(path))[0]
    ext = os.path.splitext(path)[1].lower()
    subtitle = find_subtitle(path)
    backing = find_backing(path)
    song = {'name': name, 'path': path,
            'artist': '未知', 'title': name,
            'is_video': ext in VIDEO_EXTS,
            'subtitle': subtitle,
            'backing': backing}
    state['queue'].append(song)
    # 若当前没在播，立即播放
    if not state['playing'] and state['current_index'] < 0:
        state['current_index'] = len(state['queue']) - 1
        play_current()
    return jsonify({'ok': True, 'index': len(state['queue']) - 1})


@app.route('/api/playindex')
def api_playindex():
    """播放队列指定索引"""
    try:
        idx = int(request.args.get('index', -1))
    except ValueError:
        return jsonify({'ok': False, 'error': 'bad index'})
    if 0 <= idx < len(state['queue']):
        state['current_index'] = idx
        play_current()
        return jsonify({'ok': True})
    return jsonify({'ok': False, 'error': 'index out of range'})


@app.route('/api/next')
def api_next():
    """下一首"""
    if state['queue'] and state['current_index'] < len(state['queue']) - 1:
        state['current_index'] += 1
        play_current()
        return jsonify({'ok': True})
    return jsonify({'ok': False, 'error': '没有下一首'})


@app.route('/api/prev')
def api_prev():
    """上一首"""
    if state['queue'] and state['current_index'] > 0:
        state['current_index'] -= 1
        play_current()
        return jsonify({'ok': True})
    return jsonify({'ok': False, 'error': '没有上一首'})


@app.route('/api/pause')
def api_pause():
    """暂停/恢复（用 mpv 则发信号，这里简化用终止播放实现暂停）"""
    if state['playing']:
        stop_player()
        state['playing'] = False
    else:
        play_current()
    return jsonify({'ok': True, 'playing': state['playing']})


@app.route('/api/stop', methods=['POST'])
def api_stop():
    stop_player()
    state['playing'] = False
    state['current'] = None
    return jsonify({'ok': True})


@app.route('/api/queue')
def api_queue():
    """返回播放队列"""
    result = []
    for i, s in enumerate(state['queue']):
        result.append({'index': i, 'path': s['path'],
                       'name': os.path.splitext(os.path.basename(s['path']))[0],
                       'active': i == state['current_index']})
    return jsonify(result)


@app.route('/api/state')
def api_state():
    cur = state['current']
    return jsonify({
        'playing': state['playing'],
        'volume': state['volume'],
        'current': state['current'],
        'queue_len': len(state['queue']),
        'current_index': state['current_index'],
        'mode': state['mode'],
        'has_subtitle': bool(cur and cur.get('subtitle')),
        'has_backing': bool(cur and cur.get('backing')),
    })


@app.route('/api/toggle_mode')
def api_toggle_mode():
    """切换当前歌曲的播放模式：导唱(人声)/伴奏"""
    m = request.args.get('mode', '')
    if m in ('lead', 'backing'):
        state['mode'] = m
    else:
        # 没有指定则反转
        state['mode'] = 'backing' if state['mode'] == 'lead' else 'lead'
    # 若正在播放且有伴奏支持，立即以新模式重播当前曲
    if state['playing'] and state['current'] and 0 <= state['current_index'] < len(state['queue']):
        play_current()
    return jsonify({'ok': True, 'mode': state['mode']})


@app.route('/api/volume')
def api_volume():
    try:
        v = max(0, min(100, int(request.args.get('v', state['volume']))))
    except ValueError:
        v = state['volume']
    state['volume'] = v  # 播放下一首时生效
    return jsonify({'ok': True, 'volume': v})


@app.route('/songs/<path:filename>')
def serve_song(filename):
    return send_from_directory(SONGS_DIR, filename)


def parse_srt(path):
    """解析 SRT 字幕文件，返回 [{time, text}]（time 单位：秒，用于前端同步歌词）"""
    cues = []
    try:
        with open(path, 'r', encoding='utf-8-sig') as f:
            content = f.read()
    except Exception:
        return cues
    # 按 cue 分块（空行分隔）
    blocks = re.split(r'\n\s*\n', content.strip())

    def to_sec(h, mi, s, ms):
        return int(h) * 3600 + int(mi) * 60 + int(s) + int(ms) / 1000.0

    for block in blocks:
        lines = [l.strip() for l in block.split('\n') if l.strip()]
        if len(lines) < 2:
            continue
        # 找出包含 --> 的时间行
        tline = next((i for i, l in enumerate(lines) if '-->' in l), -1)
        if tline < 0:
            continue
        m = re.search(r'(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)',
                      lines[tline])
        if not m:
            continue
        start = to_sec(m.group(1), m.group(2), m.group(3), m.group(4))
        end = to_sec(m.group(5), m.group(6), m.group(7), m.group(8))
        text = ' '.join(lines[tline + 1:])
        cues.append({'start': round(start, 3), 'end': round(end, 3), 'text': text})
    return cues


@app.route('/api/subtitle')
def api_subtitle():
    """返回指定歌曲的歌词（解析成 [{start,end,text}]，供手机同步显示）

    支持两种方式查歌词：
      - ?path= 本地文件路径
      - ?url=  相对 url（/songs/xxx.mp4），自动找同名字幕
    """
    p = request.args.get('path', '') or request.args.get('url', '')
    if not p and state['current'] and state['current'].get('subtitle'):
        p = state['current']['subtitle']
    if not p:
        return jsonify({'ok': False, 'error': '无歌词'}), 404
    if p.startswith('/songs/'):
        # url 形式 -> 转成磁盘路径再找同名字幕
        rel = p[len('/songs/'):]
        media = os.path.join(SONGS_DIR, rel.replace('/', os.sep))
        sub = find_subtitle(media)
    elif os.path.isfile(p) and os.path.splitext(p)[1].lower() in SUBTITLE_EXTS:
        sub = p
    else:
        # 视为媒体路径，找同名字幕
        sub = find_subtitle(p)
    if not sub:
        return jsonify({'ok': False, 'error': '该歌曲无歌词'}), 404
    cues = parse_srt(sub)
    name = os.path.splitext(os.path.basename(sub))[0]
    return jsonify({'ok': True, 'lyrics': cues, 'name': name})



@app.route('/api/ytsearch')
def api_ytsearch():
    """用 yt-dlp 搜索 YouTube，返回结果列表"""
    q = request.args.get('q', '').strip()
    if not q:
        return jsonify({'ok': False, 'error': '请输入搜索关键词'})
    try:
        proc = subprocess.run(
            [YTDLP, '--flat-playlist', '-J',
             'ytsearch10:' + q],
            capture_output=True, text=True, timeout=45,
        )
        if proc.returncode != 0 or not proc.stdout.strip():
            err = proc.stderr.strip().split('\n')[-1] if proc.stderr.strip() else '搜索失败'
            return jsonify({'ok': False, 'error': err})
        import json as j
        data = j.loads(proc.stdout)
        entries = data.get('entries', [])
        results = []
        for e in entries:
            vid = e.get('id')
            if not vid:
                continue
            results.append({
                'id': vid,
                'title': e.get('title', '未知'),
                'artist': (e.get('uploader') or e.get('channel') or '').strip() or '未知',
                'duration': e.get('duration') or 0,
                'url': 'https://www.youtube.com/watch?v=' + vid,
            })
        return jsonify({'ok': True, 'results': results})
    except subprocess.TimeoutExpired:
        return jsonify({'ok': False, 'error': '搜索超时'})
    except FileNotFoundError:
        return jsonify({'ok': False, 'error': '未安装 yt-dlp'})
    except Exception:
        return jsonify({'ok': False, 'error': '搜索失败'})


@app.route('/api/download_url', methods=['POST'])
def api_download_url():
    """从网址下载影片+字幕，加入播放队列"""
    data = request.get_json(silent=True) or {}
    url = data.get('url', '').strip()
    if not url:
        return jsonify({'ok': False, 'error': '请输入网址'})
    os.makedirs(SONGS_DIR, exist_ok=True)
    # 先用 yt-dlp 获取标题
    try:
        info_cmd = [YTDLP, '--no-download', '--print', '%(title)s', '--no-warnings', url]
        result = subprocess.run(info_cmd, capture_output=True, text=True, timeout=30)
        title = result.stdout.strip().split('\n')[0] if result.stdout.strip() else '未知影片'
    except Exception:
        title = '未知影片'
    # 下载影片+字幕到 songs/ 目录
    output_template = os.path.join(SONGS_DIR, '%(title)s.%(ext)s')
    dl_cmd = [
        YTDLP,
        '-o', output_template,
        '--write-subs', '--write-auto-subs',
        '--sub-langs', 'zh.*,zh-Hant,zh-Hans,en,ja,ko',
        '--convert-subs', 'srt',
        '--merge-output-format', 'mp4',
        '-f', 'bv*[height<=720]+ba/b[height<=720]',
        '--no-overwrites',
        '--no-warnings',
        url,
    ]
    try:
        proc = subprocess.run(dl_cmd, capture_output=True, text=True, timeout=300)
        if proc.returncode != 0:
            err = proc.stderr.strip().split('\n')[-1] if proc.stderr.strip() else '下载失败'
            return jsonify({'ok': False, 'error': err})
    except subprocess.TimeoutExpired:
        return jsonify({'ok': False, 'error': '下载超时（超过5分钟）'})
    except FileNotFoundError:
        return jsonify({'ok': False, 'error': '未安装 yt-dlp，请先运行 sudo apt install yt-dlp'})
    # 找到刚下载的文件（按修改时间排序取最新）
    candidates = []
    for f in os.listdir(SONGS_DIR):
        full = os.path.join(SONGS_DIR, f)
        if os.path.isfile(full) and not f.endswith('_伴奏' + os.path.splitext(f)[1]):
            ext = os.path.splitext(f)[1].lower()
            if ext in AUDIO_EXTS or ext in VIDEO_EXTS:
                candidates.append((os.path.getmtime(full), full))
    if not candidates:
        return jsonify({'ok': False, 'error': '下载完成但找不到影片文件'})
    candidates.sort(reverse=True)
    path = candidates[0][1]
    name = os.path.splitext(os.path.basename(path))[0]
    ext = os.path.splitext(path)[1].lower()
    subtitle = find_subtitle(path)
    backing = find_backing(path)
    song = {
        'name': name, 'path': path,
        'artist': '网络', 'title': name,
        'is_video': ext in VIDEO_EXTS,
        'subtitle': subtitle,
        'backing': backing,
        'url': '/songs/' + os.path.relpath(path, SONGS_DIR).replace(os.sep, '/'),
    }
    state['queue'].append(song)
    if not state['playing'] and state['current_index'] < 0:
        state['current_index'] = len(state['queue']) - 1
        play_current()
    return jsonify({'ok': True, 'name': name, 'index': len(state['queue']) - 1,
                    'has_subtitle': bool(subtitle)})


@app.route('/api/media')
def api_media():
    """返回当前歌曲的媒体信息（视频/字幕路径）"""
    if state['current']:
        return jsonify({
            'ok': True,
            'name': state['current'].get('name', ''),
            'path': state['current'].get('path', ''),
            'is_video': state['current'].get('is_video', False),
            'subtitle': state['current'].get('subtitle'),
            'url': state['current'].get('url', ''),
        })
    return jsonify({'ok': False, 'error': '无播放中歌曲'}), 404


if __name__ == '__main__':
    # 启动自动播放佇列线程
    start_auto_adapter()
    # 监听所有接口，手机能访问
    app.run(host='0.0.0.0', port=PORT, debug=False)
